# Copy to .env for local `vercel dev`. Never commit the real .env.
# In production these live in Vercel → Project → Settings → Environment Variables.

ANTHROPIC_API_KEY=sk-ant-...
NOTION_TOKEN=ntn_...
NOTION_DATABASE_ID=eed5b7047148462baa7741ce33d16c3a
SHARED_SECRET=

# Optional. Only used when the Shortcut sends no usable `today`.
# Defaults to America/New_York when unset.
TIMEZONE=America/New_York
